{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "padding": { "top": 1, "left": 2, "right": 3 },
        "color": { "1": "#7aa2f7", "2": "#c0caf5" }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "#7aa2f7", "title": "#bb9af7" }
    },
    "modules": [
        "title",
        "break",
        { "type": "os",       "key": "os    " },
        { "type": "host",     "key": "host  " },
        { "type": "kernel",   "key": "kernel" },
        { "type": "uptime",   "key": "uptime" },
        { "type": "packages", "key": "pkgs  " },
        { "type": "shell",    "key": "shell " },
        { "type": "wm",       "key": "wm    " },
        { "type": "terminal", "key": "term  " },
        "break",
        { "type": "cpu",      "key": "cpu   ", "keyColor": "#bb9af7" },
        { "type": "gpu",      "key": "gpu   ", "keyColor": "#bb9af7" },
        { "type": "memory",   "key": "memory", "keyColor": "#bb9af7" },
        { "type": "disk",     "key": "disk  ", "keyColor": "#bb9af7", "folders": "/" },
        { "type": "battery",  "key": "bat   ", "keyColor": "#bb9af7" },
        "break",
        "colors"
    ]
}
