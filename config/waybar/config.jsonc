{
    "layer": "top",
    "position": "top",
    "height": 36,
    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,
    "spacing": 8,

    "modules-left": ["custom/launcher", "hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock", "custom/notifications"],
    "modules-right": ["tray", "hyprland/language", "pulseaudio", "temperature", "memory", "battery", "custom/power"],

    "custom/launcher": {
        "format": "",
        "tooltip": false,
        "on-click": "rofi -show drun"
    },

    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate"
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 50,
        "separate-outputs": true
    },

    "clock": {
        "format": "  {:%H:%M}",
        "format-alt": "  {:%A, %d de %B de %Y}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "format": {
                "months": "<span color='#7aa2f7'><b>{}</b></span>",
                "weekdays": "<span color='#bb9af7'><b>{}</b></span>",
                "today": "<span color='#f7768e'><b>{}</b></span>"
            }
        }
    },

    "custom/notifications": {
        "exec": "~/.config/hypr/scripts/notifications.sh status",
        "return-type": "json",
        "interval": 30,
        "signal": 8,
        "on-click": "~/.config/hypr/scripts/notifications.sh menu",
        "on-click-right": "~/.config/hypr/scripts/notifications.sh dnd"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 10
    },

    "hyprland/language": {
        "format": "  {short}"
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "  mute",
        "format-icons": { "default": ["", "", ""] },
        "scroll-step": 5,
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    "temperature": {
        "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
        "input-filename": "temp1_input",
        "interval": 5,
        "critical-threshold": 85,
        "format": "\uf2c9  {temperatureC}°C",
        "tooltip-format": "Temperatura del procesador"
    },

    "memory": {
        "format": "  {percentage}%",
        "interval": 5,
        "tooltip-format": "{used:0.1f} GiB / {total:0.1f} GiB"
    },

    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": "{icon}  {capacity}%",
        "format-charging": "  {capacity}%",
        "format-plugged": "  {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "tooltip-format": "{timeTo}"
    },

    "custom/power": {
        "format": "",
        "tooltip": false,
        "on-click": "~/.config/hypr/scripts/powermenu.sh"
    }
}
