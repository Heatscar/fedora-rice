# Mako - Tokyo Night

font=JetBrainsMono Nerd Font 10
background-color=#1a1b26e6
text-color=#c0caf5
border-color=#7aa2f7
progress-color=over #292e42
border-size=2
border-radius=10
padding=12
margin=10
width=360
anchor=top-center
default-timeout=5000
icons=1
max-icon-size=48
max-history=50
# avisa a la campanita de la barra (scripts/notifications.sh)
on-notify=exec pkill -RTMIN+8 -x waybar

[urgency=low]
border-color=#414868

[urgency=critical]
border-color=#f7768e
default-timeout=0

# Indicador de volumen, brillo y luz nocturna (scripts/osd.sh)
[app-name=osd]
anchor=bottom-center
margin=60
width=280
text-alignment=center
border-color=#bb9af7
progress-color=over #3d59a1
default-timeout=1500
history=0

# No molestar: oculta las notificaciones (siguen llegando al historial), salvo el indicador
[mode=do-not-disturb]
invisible=1

[mode=do-not-disturb app-name=osd]
invisible=0
